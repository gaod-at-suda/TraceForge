# TraceForge 本地配置示例。
# 复制本文件为 .env 后填写真实 API Key；不要把 .env 提交到 Git。
TRACEFORGE_API_KEY=your_deepseek_api_key_here
TRACEFORGE_MODEL=deepseek-v4-flash
TRACEFORGE_BASE_URL=https://api.deepseek.com
TRACEFORGE_AGENT_MODE=auto

# 可选高级配置
TRACEFORGE_MAX_STEPS=20
TRACEFORGE_COMMAND_TIMEOUT=30
TRACEFORGE_MAX_TOOL_OUTPUT=8000
TRACEFORGE_MAX_HISTORY_TURNS=8
TRACEFORGE_MAX_CONTEXT_CHARS=48000
TRACEFORGE_CONDENSED_SUMMARY_CHARS=6000
TRACEFORGE_VERIFICATION_RETRIES=2
